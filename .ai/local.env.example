# Local configuration for full AI automation.
#
# To enable the scheduler, create .ai/local.env from this example and adjust
# commands for your laptop. The real .ai/local.env is ignored by git.

# launchd has a small default PATH, so include Homebrew and system paths.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

# Required by scripts/ai/run-next-ai-task.sh.
# Codex CLI reads the generated prompt from stdin.
export AI_AGENT_COMMAND='codex exec --ask-for-approval never --sandbox workspace-write - < {prompt}'

# Optional verification. Keep this conservative at first.
export AI_VERIFY_COMMAND='cd frontend && npm run build'

# Optional commit message. {issue} is replaced by the issue number.
export AI_COMMIT_MESSAGE='chore: implement issue #{issue}'

# Optional scheduler interval used by scripts/ai/install-launch-agent.sh.
export AI_RUNNER_INTERVAL_SECONDS=900
